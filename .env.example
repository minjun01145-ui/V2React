# Firebase Web configuration. These values identify the Firebase project; they are not admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=v2react-jurye-classroom
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public identifier of the dedicated Firebase Auth admin account.
# IMPORTANT: never put the admin password in a VITE_ variable or in source code.
VITE_ADMIN_AUTH_EMAIL=

VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
VITE_DEFAULT_ROOM_ID=main-class

# Optional. Configure Firebase App Check with a reCAPTCHA Enterprise website key.
# This site key is public; the secret remains managed by Google/Firebase.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
