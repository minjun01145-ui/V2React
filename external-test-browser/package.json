{
  "name": "classroom-external-test-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/start.ps1",
    "test": "node --test tests/settings.test.mjs tests/cache.test.mjs",
    "test:browser": "node launch.mjs tests/browser.test.mjs",
    "test:cache": "node launch.mjs tests/cache-browser.test.mjs",
    "test:student-session": "node launch.mjs tests/student-session.test.mjs",
    "test:passwords": "node launch.mjs tests/passwords.test.mjs",
    "test:slide-editor": "node launch.mjs tests/slide-editor.test.mjs",
    "test:slide-templates": "node launch.mjs tests/slide-templates.test.mjs",
    "test:slide-assistant": "node launch.mjs tests/slide-assistant.test.mjs",
    "test:slide-snapping": "node launch.mjs tests/slide-snapping.test.mjs",
    "test:opinions-page": "node launch.mjs tests/opinions-page.test.mjs",
    "test:slide-question": "node launch.mjs tests/slide-question.test.mjs",
    "test:matching-cards": "node launch.mjs tests/matching-cards.test.mjs",
    "test:worksheets": "firebase emulators:exec --config ../firebase.emulators.json --only firestore --project demo-worksheet \"node launch.mjs tests/worksheets.test.mjs\"",
    "test:settings-fonts": "node launch.mjs tests/settings-fonts.test.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1"
  }
}
