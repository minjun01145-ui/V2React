{
  "rules": {
    ".read": false,
    ".write": false,
    "drawingBoards": {
      "v1": {
        "$tenantId": {
          "$roomId": {
            "$boardId": {
              ".read": "auth != null && auth.token.tenantId === $tenantId && root.child('drawingAccess/v1').child($tenantId).child($roomId).child($boardId).child(auth.uid).val() === true",
              "writers": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && auth.token.role === 'student' && auth.token.tenantId === $tenantId && root.child('drawingAccess/v1').child($tenantId).child($roomId).child($boardId).child(auth.uid).val() === true && newData.exists()",
                  ".validate": "newData.hasChildren(['t', 'g']) && newData.child('g').val() === (newData.parent().parent().child('generation').exists() ? newData.parent().parent().child('generation').val() : 0)",
                  "t": { ".validate": "newData.isNumber() && newData.val() === now" },
                  "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
                  "$other": { ".validate": false }
                }
              },
              "strokes": {
                "$strokeId": {
                  ".write": "auth != null && auth.token.role === 'student' && auth.token.tenantId === $tenantId && root.child('drawingAccess/v1').child($tenantId).child($roomId).child($boardId).child(auth.uid).val() === true && newData.parent().parent().child('writers').child(auth.uid).child('t').val() === now && ((newData.exists() && !data.exists() && newData.child('by').val() === auth.uid && $strokeId === auth.uid + '_' + newData.child('s').val() && (!root.child('drawingBoards/v1').child($tenantId).child($roomId).child($boardId).child('writers').child(auth.uid).child('t').exists() || root.child('drawingBoards/v1').child($tenantId).child($roomId).child($boardId).child('writers').child(auth.uid).child('t').val() <= now - 600)) || (!newData.exists() && data.child('by').val() === auth.uid && newData.parent().parent().child('writers').child(auth.uid).child('g').val() === data.child('g').val()))",
                  ".validate": "newData.hasChildren(['by', 's', 'l', 'c', 'w', 'p', 'g', 't']) && newData.child('g').val() === (newData.parent().parent().child('generation').exists() ? newData.parent().parent().child('generation').val() : 0)",
                  "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
                  "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 80 && newData.val() % 1 === 0" },
                  "l": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
                  "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360 && newData.val() % 1 === 0" },
                  "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10 && newData.val() % 1 === 0" },
                  "w": { ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 6 || newData.val() === 10)" },
                  "p": { ".validate": "newData.isString() && newData.val().length <= 1152 && newData.val().matches(/^([0-9]{6}){1,192}$/)" },
                  "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0" },
                  "t": { ".validate": "newData.isNumber() && newData.val() === now" },
                  "$other": { ".validate": false }
                }
              }
            }
          }
        }
      }
    },
    "liveWorld": {
      "v2": {
        "$tenantId": {
          "$roomId": {
            "$roundId": {
              "$channelId": {
                "players": {
                  ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                  "$playerId": {
                    ".write": "auth != null && auth.uid === $playerId && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                    ".validate": "newData.hasChildren(['x', 'y', 'vx', 'vy', 'q', 't'])",
                    "x": { ".validate": "newData.isNumber() && newData.val() >= -10000000 && newData.val() <= 10000000" },
                    "y": { ".validate": "newData.isNumber() && newData.val() >= -10000000 && newData.val() <= 10000000" },
                    "vx": { ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000" },
                    "vy": { ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000" },
                    "q": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991" },
                    "t": { ".validate": "newData.isNumber() && newData.val() > 0" },
                    "$other": { ".validate": false }
                  }
                },
                "events": {
                  ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                  "$playerId": {
                    ".write": "auth != null && auth.uid === $playerId && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                    ".validate": "newData.hasChildren(['k', 'g', 'v', 'q', 't'])",
                    "k": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
                    "g": { ".validate": "newData.isString() && newData.val().length <= 128" },
                    "v": { ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10" },
                    "q": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740991" },
                    "t": { ".validate": "newData.isNumber() && newData.val() === now" },
                    "$other": { ".validate": false }
                  }
                },
                "records": {
                  ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                  ".indexOn": ["s"],
                  "$playerId": {
                    ".write": "auth != null && auth.uid === $playerId && newData.exists() && (!data.exists() || newData.child('s').val() > data.child('s').val()) && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                    ".validate": "newData.hasChildren(['s', 'l', 't'])",
                    "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
                    "l": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
                    "t": { ".validate": "newData.isNumber() && newData.val() === now" },
                    "$other": { ".validate": false }
                  }
                },
                "claims": {
                  ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                  "$claimId": {
                    ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && auth.token.tenantId === $tenantId && (auth.token.role === 'student' || auth.token.firebase.sign_in_provider !== 'anonymous')",
                    ".validate": "$claimId.length <= 40 && newData.hasChildren(['by', 't'])",
                    "by": { ".validate": "newData.isString()" },
                    "t": { ".validate": "newData.isNumber() && newData.val() === now" },
                    "$other": { ".validate": false }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
