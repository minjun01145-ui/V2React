rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function isRosterStudent() {
      return signedIn()
        && request.auth.token.role == "student"
        && request.auth.token.studentNumber is string
        && request.auth.token.displayName is string
        && exists(/databases/$(database)/documents/studentRoster/$(request.auth.token.studentNumber))
        && get(/databases/$(database)/documents/studentRoster/$(request.auth.token.studentNumber)).data.active != false
        && get(/databases/$(database)/documents/studentRoster/$(request.auth.token.studentNumber)).data.displayName == request.auth.token.displayName;
    }

    function isTestStudentForRoom(roomId) {
      return signedIn()
        && request.auth.token.role == "test-student"
        && request.auth.token.studentNumber is string
        && request.auth.token.displayName is string
        && request.auth.token.testOwnerUid is string
        && request.auth.token.testRoomId == roomId
        && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.isTestSession == true
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.testOwnerUid == request.auth.token.testOwnerUid;
    }

    function isRoomStudent(roomId) {
      return isRosterStudent() || isTestStudentForRoom(roomId);
    }

    function ownsStudentGameData(accountId) {
      return signedIn()
        && (
          (isRosterStudent() && accountId == request.auth.token.studentNumber)
          || (request.auth.token.role == "test-student" && accountId == "test-" + request.auth.uid)
        );
    }

    function validPokemonInventory(inventory) {
      return inventory is map
        && inventory.keys().hasOnly(["pokeBall", "greatBall", "sleepSpray", "anger"])
        && inventory.pokeBall is int && inventory.pokeBall >= 0
        && inventory.greatBall is int && inventory.greatBall >= 0
        && inventory.sleepSpray is int && inventory.sleepSpray >= 0
        && inventory.anger is int && inventory.anger >= 0;
    }

    function validStudentCosmetics(data) {
      return data.keys().hasOnly(["equippedCharacterId", "updatedAt", "updatedAtMs"])
        && data.equippedCharacterId is string
        && data.equippedCharacterId.size() >= 1
        && data.equippedCharacterId.size() <= 120
        && data.updatedAtMs is int;
    }

    function publicLearningSetRead() {
      return true;
    }

    function activeRound(roomId, roundId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "playing"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.roundId == roundId;
    }

    function preparingRound(roomId, roundId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "preparing"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.roundId == roundId;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /studentRoster/{studentNumber} {
      allow read, write: if false;
    }

    match /studentPinCredentials/{studentNumber} {
      allow read, write: if false;
    }

    match /authRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /aiProviderConfigs/{providerId} {
      allow read, write: if false;
    }

    match /aiTutorRateLimits/{uid} {
      allow read, write: if false;
    }

    match /multiplayerTestRuns/{adminUid} {
      allow read, write: if false;
    }

    match /learningSets/{setId} {
      allow read: if publicLearningSetRead();
      allow create, update, delete: if isAdmin();

      match /content/{contentId} {
        allow read: if publicLearningSetRead();
        allow create, update, delete: if isAdmin();
      }
    }

    match /studentProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /studentGameData/{accountId}/games/pokemon-catch {
      allow read: if ownsStudentGameData(accountId) || isAdmin();
      allow create, update: if ownsStudentGameData(accountId)
        && request.resource.data.keys().hasOnly(["inventory", "updatedAt", "updatedAtMs"])
        && validPokemonInventory(request.resource.data.inventory)
        && request.resource.data.updatedAtMs is int;
      allow delete: if isAdmin();

      match /captured/{captureId} {
        allow read: if ownsStudentGameData(accountId) || isAdmin();
        allow create: if ownsStudentGameData(accountId)
          && request.resource.data.keys().hasOnly([
            "speciesId", "name", "spriteUrl", "fallbackSpriteUrl", "caughtAt", "caughtAtMs"
          ])
          && request.resource.data.speciesId is int
          && request.resource.data.speciesId >= 1
          && request.resource.data.speciesId <= 386
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80
          && request.resource.data.spriteUrl is string
          && request.resource.data.spriteUrl.matches("https://.*")
          && (request.resource.data.fallbackSpriteUrl == null || request.resource.data.fallbackSpriteUrl is string)
          && request.resource.data.caughtAtMs is int;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /rewards/{rewardId} {
        allow read: if ownsStudentGameData(accountId) || isAdmin();
        allow create: if ownsStudentGameData(accountId)
          && request.resource.data.keys().hasOnly(["itemId", "awardedAt", "awardedAtMs"])
          && request.resource.data.itemId in ["pokeBall", "greatBall", "sleepSpray", "anger"]
          && request.resource.data.awardedAtMs is int;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /studentGameData/{accountId}/cosmetics/profile {
      allow read: if ownsStudentGameData(accountId) || isAdmin();
      allow create, update: if ownsStudentGameData(accountId)
        && validStudentCosmetics(request.resource.data);
      allow delete: if isAdmin();
    }

    match /multiplayerSessions/{roomId} {
      allow read: if isRoomStudent(roomId) || isAdmin();
      allow create, update, delete: if isAdmin();

      match /players/{uid} {
        // The lobby renders the room roster with a collection query. Every authenticated
        // student accepted for this room may read that room's player cards; writes remain
        // restricted to the caller's own UID below.
        allow read: if isAdmin() || isRoomStudent(roomId);
        allow create: if isRoomStudent(roomId)
          && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
          && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status in ["waiting", "preparing", "playing"]
          && request.auth.uid == uid
          && request.resource.data.playerId == uid
          && request.resource.data.studentNumber == request.auth.token.studentNumber
          && request.resource.data.displayName == request.auth.token.displayName
          && request.resource.data.state == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status
          && (request.resource.data.nickname == null
            || (request.resource.data.nickname is string
              && request.resource.data.nickname.size() >= 2
              && request.resource.data.nickname.size() <= 12))
          && request.resource.data.keys().hasOnly([
            "playerId", "studentNumber", "displayName", "nickname", "state",
            "joinedAt", "joinedAtMs", "lastSeenAt", "lastSeenAtMs"
          ]);
        allow update: if isRoomStudent(roomId)
          && request.auth.uid == uid
          && resource.data.playerId == uid
          && resource.data.studentNumber == request.auth.token.studentNumber
          && resource.data.displayName == request.auth.token.displayName
          && request.resource.data.studentNumber == resource.data.studentNumber
          && request.resource.data.displayName == resource.data.displayName
          && (request.resource.data.nickname == null
            || (request.resource.data.nickname is string
              && request.resource.data.nickname.size() >= 2
              && request.resource.data.nickname.size() <= 12))
          && (
            request.resource.data.state == resource.data.state
            || request.resource.data.state == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "lastSeenAt", "lastSeenAtMs", "nickname"]);
        allow delete: if isAdmin() || (isRoomStudent(roomId) && request.auth.uid == uid);
      }

      match /rounds/{roundId} {
        allow read, write: if isAdmin();

        match /readiness/{uid} {
          allow read: if isAdmin();
          allow create, update: if isRoomStudent(roomId)
            && preparingRound(roomId, roundId)
            && request.auth.uid == uid
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.readyAtMs is int
            && request.resource.data.keys().hasOnly(["playerId", "readyAt", "readyAtMs"]);
          allow delete: if isAdmin();
        }

        match /participants/{uid} {
          allow read: if isAdmin() || isRoomStudent(roomId);
          allow create: if isAdmin() || (
            isRoomStudent(roomId)
              && activeRound(roomId, roundId)
              && request.auth.uid == uid
              && request.resource.data.playerId == uid
              && request.resource.data.studentNumber == request.auth.token.studentNumber
              && request.resource.data.displayName == request.auth.token.displayName
              && (request.resource.data.nickname == null
                || (request.resource.data.nickname is string
                  && request.resource.data.nickname.size() >= 2
                  && request.resource.data.nickname.size() <= 12))
              && request.resource.data.joinedAtMs is int
              && request.resource.data.keys().hasOnly([
                "playerId", "studentNumber", "displayName", "nickname", "joinedAt", "joinedAtMs"
              ])
          );
          allow update: if isAdmin() || (
            isRoomStudent(roomId)
              && activeRound(roomId, roundId)
              && request.auth.uid == uid
              && resource.data.playerId == uid
              && request.resource.data.playerId == resource.data.playerId
              && request.resource.data.studentNumber == resource.data.studentNumber
              && request.resource.data.displayName == resource.data.displayName
              && request.resource.data.joinedAt == resource.data.joinedAt
              && request.resource.data.joinedAtMs == resource.data.joinedAtMs
              && (request.resource.data.nickname == null
                || (request.resource.data.nickname is string
                  && request.resource.data.nickname.size() >= 2
                  && request.resource.data.nickname.size() <= 12))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nickname"])
          );
          allow delete: if isAdmin();
        }

        match /answers/{answerId} {
          allow read: if isAdmin();
          allow create: if isRoomStudent(roomId)
            && activeRound(roomId, roundId)
            && request.resource.data.playerId == request.auth.uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.attemptId is string
            && answerId == request.auth.uid + ":" + request.resource.data.attemptId
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(request.auth.uid)/items/$(request.resource.data.attemptId)).data.kind == "attempt"
            && request.resource.data.keys().hasOnly([
              "attemptId", "gameId", "playerId", "displayName", "questionId",
              "prompt", "answer", "isCorrect", "scoreDelta", "totalScore",
              "attemptCount", "createdAt", "createdAtMs"
            ]);
          allow update, delete: if false;
        }

        match /operations/{uid}/items/{operationId} {
          allow read: if isAdmin() || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create: if isRoomStudent(roomId)
            && activeRound(roomId, roundId)
            && request.auth.uid == uid
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.operationId == operationId
            && request.resource.data.playerId == uid
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.kind in ["attempt", "progress"]
            && (
              (request.resource.data.kind == "attempt" && request.resource.data.itemId is string)
              || (request.resource.data.kind == "progress" && request.resource.data.itemId == null)
            )
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.createdAtMs is int
            && request.resource.data.keys().hasOnly([
              "operationId", "kind", "gameId", "playerId", "itemId", "revision", "createdAt", "createdAtMs"
            ]);
          allow update: if false;
          allow delete: if isAdmin();
        }

        match /progress/{uid} {
          allow read: if isAdmin() || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create: if isRoomStudent(roomId)
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.revision == 1
            && request.resource.data.lastOperationId is string
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(uid)/items/$(request.resource.data.lastOperationId)).data.revision == request.resource.data.revision
            && request.resource.data.keys().hasOnly([
              "gameId", "playerId", "displayName", "currentIndex", "score",
              "correctCount", "attemptCount", "combo", "completedQuestionIds", "lastResult",
              "completedAtMs", "revision", "lastOperationId", "updatedAt", "updatedAtMs"
            ])
            && request.resource.data.combo is int
            && request.resource.data.combo >= 0;
          allow update: if isRoomStudent(roomId)
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.revision is int
            && (
              (!("revision" in resource.data) && request.resource.data.revision == 1)
              || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1)
            )
            && request.resource.data.lastOperationId is string
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(uid)/items/$(request.resource.data.lastOperationId)).data.revision == request.resource.data.revision
            && request.resource.data.keys().hasOnly([
              "gameId", "playerId", "displayName", "currentIndex", "score",
              "correctCount", "attemptCount", "combo", "completedQuestionIds", "lastResult",
              "completedAtMs", "revision", "lastOperationId", "updatedAt", "updatedAtMs"
            ])
            && request.resource.data.combo is int
            && request.resource.data.combo >= 0;
          allow delete: if isAdmin();
        }

        match /liveMetrics/{uid} {
          allow read: if isAdmin() || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create, update: if isRoomStudent(roomId)
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.kind == "typing-cpm"
            && request.resource.data.currentCpm is int
            && request.resource.data.currentCpm >= 0
            && request.resource.data.currentCpm <= 5000
            && request.resource.data.averageCpm is int
            && request.resource.data.averageCpm >= 0
            && request.resource.data.averageCpm <= 5000
            && request.resource.data.bestCpm is int
            && request.resource.data.bestCpm >= 0
            && request.resource.data.bestCpm <= 5000
            && request.resource.data.bestCpm >= request.resource.data.currentCpm
            && request.resource.data.bestCpm >= request.resource.data.averageCpm
            && request.resource.data.totalValidStrokes is int
            && request.resource.data.totalValidStrokes >= 0
            && request.resource.data.totalValidStrokes <= 1000000
            && request.resource.data.sampledAtMs is int
            && request.resource.data.committedAt == request.time
            && request.resource.data.keys().hasOnly([
              "kind", "gameId", "playerId", "displayName", "currentCpm", "averageCpm",
              "bestCpm", "totalValidStrokes", "sampledAtMs", "committedAt"
            ]);
          allow delete: if isAdmin();
        }
      }
    }
  }
}
