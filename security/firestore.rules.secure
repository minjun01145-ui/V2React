rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function tenantIdFrom(data) {
      return "tenantId" in data ? data.tenantId : "minjun";
    }

    function validTenantId(tenantId) {
      return tenantId in ["minjun", "hana"];
    }

    function authTenantId() {
      return signedIn() && "tenantId" in request.auth.token ? request.auth.token.tenantId : "minjun";
    }

    function adminTenantId() {
      return isAdmin() ? tenantIdFrom(get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) : "";
    }

    function isAdminForTenant(tenantId) {
      return validTenantId(tenantId) && isAdmin() && adminTenantId() == tenantId;
    }

    function rosterKey() {
      return authTenantId() == "minjun"
        ? request.auth.token.studentNumber
        : authTenantId() + "--" + request.auth.token.studentNumber;
    }

    function isRosterStudent() {
      return signedIn()
        && request.auth.token.role == "student"
        && request.auth.token.studentNumber is string
        && request.auth.token.displayName is string
        && exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.studentNumber == request.auth.token.studentNumber
        && get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.displayName == request.auth.token.displayName
        && validTenantId(authTenantId())
        && tenantIdFrom(get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data) == authTenantId()
        && exists(/databases/$(database)/documents/studentRoster/$(rosterKey()))
        && get(/databases/$(database)/documents/studentRoster/$(rosterKey())).data.active != false;
    }

    function isTestStudentForRoom(roomId) {
      return signedIn()
        && request.auth.token.role == "test-student"
        && request.auth.token.studentNumber is string
        && request.auth.token.displayName is string
        && request.auth.token.testOwnerUid is string
        && request.auth.token.testRoomId == roomId
        && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.isTestSession == true
        && tenantIdFrom(get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data) == authTenantId()
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.testOwnerUid == request.auth.token.testOwnerUid;
    }

    function isRoomStudent(roomId) {
      return (
        isRosterStudent()
        && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && tenantIdFrom(get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data) == authTenantId()
      ) || isTestStudentForRoom(roomId);
    }

    function isRoomAdmin(roomId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && isAdminForTenant(tenantIdFrom(get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data));
    }

    function roomIdMatchesTenant(roomId, tenantId) {
      return (tenantId == "minjun" && !roomId.matches("^hana--.*$"))
        || (tenantId == "hana" && roomId.matches("^hana--.+$"));
    }

    function isTenantReader(tenantId) {
      return isAdminForTenant(tenantId)
        || (isRosterStudent() && authTenantId() == tenantId)
        || (signedIn() && request.auth.token.role == "test-student" && validTenantId(authTenantId()) && authTenantId() == tenantId);
    }

    function isAdminForStudentAccount(accountId) {
      return isAdmin() && (
        (adminTenantId() == "minjun" && accountId.matches("^[0-9]{1,12}$"))
        || (adminTenantId() == "hana" && accountId.matches("^hana--[0-9]{1,12}$"))
      );
    }

    function ownsStudentGameData(accountId) {
      return signedIn()
        && (
          (isRosterStudent() && accountId == (authTenantId() == "minjun" ? request.auth.token.studentNumber : authTenantId() + "--" + request.auth.token.studentNumber))
          || (request.auth.token.role == "test-student" && accountId == "test-" + request.auth.uid)
        );
    }

    function validPokemonInventory(inventory) {
      return inventory is map
        && inventory.keys().hasOnly(["pokeBall", "greatBall", "sleepSpray", "anger"])
        && inventory.pokeBall is int && inventory.pokeBall >= 0
        && inventory.greatBall is int && inventory.greatBall >= 0
        && inventory.sleepSpray is int && inventory.sleepSpray >= 0
        && inventory.anger is int && inventory.anger >= 0;
    }

    function validStudentCosmetics(data) {
      return data.updatedAtMs is int && (
        (data.keys().hasOnly(["equippedKind", "equippedCharacterId", "updatedAt", "updatedAtMs"])
          && data.equippedKind == "character"
          && data.equippedCharacterId is string
          && data.equippedCharacterId.size() >= 1
          && data.equippedCharacterId.size() <= 120)
        ||
        (data.keys().hasOnly([
            "equippedKind", "equippedPokemonCaptureId", "equippedPokemonName",
            "equippedPokemonSpriteUrl", "equippedPokemonFallbackSpriteUrl", "updatedAt", "updatedAtMs"
          ])
          && data.equippedKind == "pokemon"
          && data.equippedPokemonCaptureId is string
          && data.equippedPokemonCaptureId.size() >= 1
          && data.equippedPokemonCaptureId.size() <= 120
          && data.equippedPokemonName is string
          && data.equippedPokemonName.size() >= 1
          && data.equippedPokemonName.size() <= 80
          && data.equippedPokemonSpriteUrl is string
          && data.equippedPokemonSpriteUrl.matches("https://.*")
          && (data.equippedPokemonFallbackSpriteUrl == null || (
            data.equippedPokemonFallbackSpriteUrl is string
            && data.equippedPokemonFallbackSpriteUrl.matches("https://.*")
          )))
      );
    }

    function validPlayerAvatar(avatar) {
      return avatar is map && (
        (avatar.keys().hasOnly(["kind", "characterId"])
          && avatar.kind == "character"
          && avatar.characterId is string
          && avatar.characterId.size() >= 1
          && avatar.characterId.size() <= 120)
        ||
        (avatar.keys().hasOnly(["kind", "captureId", "name", "spriteUrl", "fallbackSpriteUrl"])
          && avatar.kind == "pokemon"
          && avatar.captureId is string
          && avatar.captureId.size() >= 1
          && avatar.captureId.size() <= 120
          && avatar.name is string
          && avatar.name.size() >= 1
          && avatar.name.size() <= 80
          && avatar.spriteUrl is string
          && avatar.spriteUrl.matches("https://.*")
          && (avatar.fallbackSpriteUrl == null || (
            avatar.fallbackSpriteUrl is string
            && avatar.fallbackSpriteUrl.matches("https://.*")
          )))
      );
    }

    function validDiceResults(values, count) {
      return values is list
        && count is int
        && count >= 1
        && count <= 3
        && values.size() == count
        && values[0] is int && values[0] >= 1 && values[0] <= 6
        && (count < 2 || (values[1] is int && values[1] >= 1 && values[1] <= 6))
        && (count < 3 || (values[2] is int && values[2] >= 1 && values[2] <= 6));
    }

    function activeRound(roomId, roundId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "playing"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.roundId == roundId
        && (!("quizGame" in get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data)
          || get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.quizGame.phase == "answering");
    }

    function preparingRound(roomId, roundId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "preparing"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.roundId == roundId;
    }

    function activeStudentQuestionRun(roomId, runId) {
      return exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "waiting"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.classroomActivity.kind == "student-question-authoring"
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.classroomActivity.runId == runId
        && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.classroomActivity.phase == "active";
    }

    function validStudentQuestionItem(items, index, englishOnly) {
      return index >= items.size() || (
        items[index] is map
        && items[index].keys().hasOnly(["question", "referenceAnswer"])
        && items[index].question is string
        && items[index].question.size() >= 1
        && items[index].question.size() <= 500
        && items[index].question.matches(".*\\S.*")
        && (!englishOnly || !items[index].question.matches(".*[가-힣ㄱ-ㅎㅏ-ㅣ].*"))
        && items[index].referenceAnswer is string
        && items[index].referenceAnswer.size() >= 1
        && items[index].referenceAnswer.size() <= 1000
        && items[index].referenceAnswer.matches(".*\\S.*")
      );
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /studentRoster/{studentNumber} {
      allow read, write: if false;
    }

    match /studentPinCredentials/{studentNumber} {
      allow read, write: if false;
    }

    match /authRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /aiProviderConfigs/{providerId} {
      allow read, write: if false;
    }

    match /aiTutorRateLimits/{uid} {
      allow read, write: if false;
    }

    match /multiplayerTestRuns/{adminUid} {
      allow read, write: if false;
    }

    match /learningSets/{setId} {
      allow read: if isTenantReader("minjun");
      allow create, update, delete: if isAdminForTenant("minjun");

      match /content/{contentId} {
        allow read: if isTenantReader("minjun");
        allow create, update, delete: if isAdminForTenant("minjun");
      }
    }

    match /tenants/{tenantId}/learningSets/{setId} {
      allow read: if tenantId != "minjun" && isTenantReader(tenantId);
      allow create: if tenantId != "minjun" && isAdminForTenant(tenantId)
        && request.resource.data.tenantId == tenantId;
      allow update: if tenantId != "minjun" && isAdminForTenant(tenantId)
        && resource.data.tenantId == tenantId
        && request.resource.data.tenantId == tenantId;
      allow delete: if tenantId != "minjun" && isAdminForTenant(tenantId)
        && resource.data.tenantId == tenantId;

      match /content/{contentId} {
        allow read: if tenantId != "minjun" && isTenantReader(tenantId);
        allow create, update, delete: if tenantId != "minjun" && isAdminForTenant(tenantId);
      }
    }

    match /studentProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdminForTenant(tenantIdFrom(resource.data)));
      allow write: if false;
    }

    match /studentGameData/{accountId}/games/pokemon-catch {
      allow read: if ownsStudentGameData(accountId) || isAdminForStudentAccount(accountId);
      allow create, update: if ownsStudentGameData(accountId)
        && request.resource.data.keys().hasOnly(["inventory", "updatedAt", "updatedAtMs"])
        && validPokemonInventory(request.resource.data.inventory)
        && request.resource.data.updatedAtMs is int;
      allow delete: if isAdminForStudentAccount(accountId);

      match /captured/{captureId} {
        allow read: if ownsStudentGameData(accountId) || isAdminForStudentAccount(accountId);
        allow create: if ownsStudentGameData(accountId)
          && request.resource.data.keys().hasOnly([
            "speciesId", "name", "nickname", "level", "types", "description", "heightMeters", "weightKg",
            "spriteUrl", "fallbackSpriteUrl", "caughtAt", "caughtAtMs"
          ])
          && request.resource.data.speciesId is int
          && request.resource.data.speciesId >= 1
          && request.resource.data.speciesId <= 386
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80
          && (request.resource.data.nickname == null || (
            request.resource.data.nickname is string
            && request.resource.data.nickname.size() >= 1
            && request.resource.data.nickname.size() <= 12
          ))
          && request.resource.data.level is int
          && request.resource.data.level >= 1
          && request.resource.data.level <= 100
          && request.resource.data.types is list
          && request.resource.data.types.size() <= 2
          && (request.resource.data.types.size() == 0 || request.resource.data.types[0] is string)
          && (request.resource.data.types.size() < 2 || request.resource.data.types[1] is string)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && (request.resource.data.heightMeters == null || (
            request.resource.data.heightMeters is number
            && request.resource.data.heightMeters > 0
            && request.resource.data.heightMeters <= 100
          ))
          && (request.resource.data.weightKg == null || (
            request.resource.data.weightKg is number
            && request.resource.data.weightKg > 0
            && request.resource.data.weightKg <= 10000
          ))
          && request.resource.data.spriteUrl is string
          && request.resource.data.spriteUrl.matches("https://.*")
          && (request.resource.data.fallbackSpriteUrl == null || request.resource.data.fallbackSpriteUrl is string)
          && request.resource.data.caughtAtMs is int;
        allow update: if false;
        allow delete: if isAdminForStudentAccount(accountId);
      }

      match /rewards/{rewardId} {
        allow read: if ownsStudentGameData(accountId) || isAdminForStudentAccount(accountId);
        allow create: if ownsStudentGameData(accountId)
          && request.resource.data.keys().hasOnly(["itemId", "awardedAt", "awardedAtMs"])
          && request.resource.data.itemId in ["pokeBall", "greatBall", "sleepSpray", "anger"]
          && request.resource.data.awardedAtMs is int;
        allow update: if false;
        allow delete: if isAdminForStudentAccount(accountId);
      }
    }

    match /quizGamePlans/{planId} {
      allow read, create, update, delete: if isAdminForTenant("minjun");
    }

    match /tenants/{tenantId}/quizGamePlans/{planId} {
      allow read, create, update, delete: if tenantId != "minjun" && isAdminForTenant(tenantId);
    }

    match /studentGameData/{accountId}/cosmetics/profile {
      allow read: if ownsStudentGameData(accountId) || isAdminForStudentAccount(accountId);
      allow create, update: if ownsStudentGameData(accountId)
        && validStudentCosmetics(request.resource.data);
      allow delete: if isAdminForStudentAccount(accountId);
    }

    match /multiplayerSessions/{roomId} {
      allow read: if isRoomStudent(roomId) || isRoomAdmin(roomId);
      allow create: if validTenantId(tenantIdFrom(request.resource.data))
        && roomIdMatchesTenant(roomId, tenantIdFrom(request.resource.data))
        && request.resource.data.roomId == roomId
        && isAdminForTenant(tenantIdFrom(request.resource.data));
      allow update: if isRoomAdmin(roomId)
        && request.resource.data.roomId == roomId
        && tenantIdFrom(request.resource.data) == tenantIdFrom(resource.data);
      allow delete: if isRoomAdmin(roomId);

      match /players/{uid} {
        // The lobby renders the room roster with a collection query. Every authenticated
        // student accepted for this room may read that room's player cards; writes remain
        // restricted to the caller's own UID below.
        allow read: if isRoomAdmin(roomId) || isRoomStudent(roomId);
        allow create: if isRoomStudent(roomId)
          && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId))
          && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status in ["waiting", "preparing", "playing"]
          && request.auth.uid == uid
          && request.resource.data.playerId == uid
          && request.resource.data.studentNumber == request.auth.token.studentNumber
          && request.resource.data.displayName == request.auth.token.displayName
          && request.resource.data.state == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status
          && (request.resource.data.nickname == null
            || (request.resource.data.nickname is string
              && request.resource.data.nickname.size() >= 2
              && request.resource.data.nickname.size() <= 12))
          && request.resource.data.keys().hasOnly([
            "playerId", "studentNumber", "displayName", "nickname", "state",
            "joinedAt", "joinedAtMs", "lastSeenAt", "lastSeenAtMs", "avatar"
          ])
          && (!("avatar" in request.resource.data) || validPlayerAvatar(request.resource.data.avatar));
        allow update: if isRoomStudent(roomId)
          && request.auth.uid == uid
          && resource.data.playerId == uid
          && resource.data.studentNumber == request.auth.token.studentNumber
          && resource.data.displayName == request.auth.token.displayName
          && request.resource.data.studentNumber == resource.data.studentNumber
          && request.resource.data.displayName == resource.data.displayName
          && (request.resource.data.nickname == null
            || (request.resource.data.nickname is string
              && request.resource.data.nickname.size() >= 2
              && request.resource.data.nickname.size() <= 12))
          && (
            request.resource.data.state == resource.data.state
            || request.resource.data.state == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "lastSeenAt", "lastSeenAtMs", "nickname", "avatar"])
          && (!("avatar" in request.resource.data) || validPlayerAvatar(request.resource.data.avatar));
        allow delete: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
      }

      match /waitingDiceRequests/{uid} {
        allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
        allow create, update, delete: if isRoomAdmin(roomId);
        allow update: if isRoomStudent(roomId)
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.status == "waiting"
          && resource.data.rollerId == uid
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.diceCount == resource.data.diceCount
          && request.resource.data.rollerId == resource.data.rollerId
          && request.resource.data.rollerLabel == resource.data.rollerLabel
          && request.resource.data.requestedAt == resource.data.requestedAt
          && request.resource.data.requestedAtMs == resource.data.requestedAtMs
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedAtMs is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["phase", "results", "updatedAt", "updatedAtMs"])
          && (
            (resource.data.phase == "requested"
              && resource.data.results.size() == 0
              && request.resource.data.phase == "rolling"
              && request.resource.data.results.size() == 0)
            ||
            (resource.data.phase == "rolling"
              && resource.data.results.size() == 0
              && request.resource.data.phase == "result"
              && validDiceResults(request.resource.data.results, resource.data.diceCount))
          );
      }

      match /studentQuestionRuns/{runId} {
        allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid in resource.data.expectedPlayerIds);
        allow create, update, delete: if isRoomAdmin(roomId);

        match /submissions/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create: if isRoomStudent(roomId)
            && request.auth.uid == uid
            && activeStudentQuestionRun(roomId, runId)
            && request.auth.uid in get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.expectedPlayerIds
            && request.resource.data.keys().hasOnly(["playerId", "questions", "submitted", "submittedAt", "submittedAtMs"])
            && request.resource.data.playerId == uid
            && request.resource.data.submitted == true
            && request.resource.data.submittedAt == request.time
            && request.resource.data.submittedAtMs is int
            && request.resource.data.questions is list
            && request.resource.data.questions.size() == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.questionCount
            && request.resource.data.questions.size() >= 1
            && request.resource.data.questions.size() <= 5
            && validStudentQuestionItem(request.resource.data.questions, 0, get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.englishQuestionsOnly)
            && validStudentQuestionItem(request.resource.data.questions, 1, get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.englishQuestionsOnly)
            && validStudentQuestionItem(request.resource.data.questions, 2, get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.englishQuestionsOnly)
            && validStudentQuestionItem(request.resource.data.questions, 3, get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.englishQuestionsOnly)
            && validStudentQuestionItem(request.resource.data.questions, 4, get(/databases/$(database)/documents/multiplayerSessions/$(roomId)/studentQuestionRuns/$(runId)).data.config.englishQuestionsOnly);
          allow update, delete: if false;
        }
      }

      match /rounds/{roundId} {
        allow read, write: if isRoomAdmin(roomId);

        match /freeResponses/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow write: if false;
        }

        match /readiness/{uid} {
          allow read: if isRoomAdmin(roomId);
          allow create, update: if isRoomStudent(roomId)
            && preparingRound(roomId, roundId)
            && request.auth.uid == uid
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.readyAtMs is int
            && request.resource.data.keys().hasOnly(["playerId", "readyAt", "readyAtMs"]);
          allow delete: if isRoomAdmin(roomId);
        }

        match /participants/{uid} {
          allow read: if isRoomAdmin(roomId) || isRoomStudent(roomId);
          allow create: if isRoomAdmin(roomId) || (
            isRoomStudent(roomId)
              && activeRound(roomId, roundId)
              && request.auth.uid == uid
              && request.resource.data.playerId == uid
              && request.resource.data.studentNumber == request.auth.token.studentNumber
              && request.resource.data.displayName == request.auth.token.displayName
              && (request.resource.data.nickname == null
                || (request.resource.data.nickname is string
                  && request.resource.data.nickname.size() >= 2
                  && request.resource.data.nickname.size() <= 12))
              && request.resource.data.joinedAtMs is int
              && request.resource.data.keys().hasOnly([
                "playerId", "studentNumber", "displayName", "nickname", "joinedAt", "joinedAtMs"
              ])
          );
          allow update: if isRoomAdmin(roomId) || (
            isRoomStudent(roomId)
              && activeRound(roomId, roundId)
              && request.auth.uid == uid
              && resource.data.playerId == uid
              && request.resource.data.playerId == resource.data.playerId
              && request.resource.data.studentNumber == resource.data.studentNumber
              && request.resource.data.displayName == resource.data.displayName
              && request.resource.data.joinedAt == resource.data.joinedAt
              && request.resource.data.joinedAtMs == resource.data.joinedAtMs
              && (request.resource.data.nickname == null
                || (request.resource.data.nickname is string
                  && request.resource.data.nickname.size() >= 2
                  && request.resource.data.nickname.size() <= 12))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nickname"])
          );
          allow delete: if isRoomAdmin(roomId);
        }

        // 협동 게임의 조원 목록은 교사와 서버만 읽는다. 학생에게는 본인용
        // assignment 문서만 공개하며, 완료 전에는 이 문서에 조원 식별자를 넣지 않는다.
        match /cooperativeState/{documentId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /cooperativeTeams/{teamId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /cooperativeAssignments/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow write: if false;
        }

        match /cooperativeOperations/{uid}/items/{operationId} {
          allow read, write: if false;
        }

        // 배틀의 매칭 정보와 기준 답안은 서버·교사만 읽는다. 학생은 상대의
        // 식별자가 제거된 본인 assignment만 구독한다.
        match /battleState/{documentId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /battleMatches/{matchId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /battleAssignments/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow write: if false;
        }

        match /battleStats/{uid} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        // Word UNO의 덱·상대 손패·턴 원본 상태는 서버와 교사에게만 공개한다.
        // 학생은 본인 손패와 공개 그룹 정보만 담긴 assignment 문서만 읽는다.
        match /wordUnoState/{documentId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /wordUnoGroups/{groupId} {
          allow read: if isRoomAdmin(roomId);
          allow write: if false;
        }

        match /wordUnoAssignments/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow write: if false;
        }

        match /wordUnoOperations/{uid}/items/{operationId} {
          allow read, write: if false;
        }

        match /answers/{answerId} {
          allow read: if isRoomAdmin(roomId);
          allow create: if isRoomStudent(roomId)
            && activeRound(roomId, roundId)
            && request.resource.data.playerId == request.auth.uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.attemptId is string
            && answerId == request.auth.uid + ":" + request.resource.data.attemptId
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(request.auth.uid)/items/$(request.resource.data.attemptId)).data.kind == "attempt"
            && request.resource.data.keys().hasOnly([
              "attemptId", "gameId", "playerId", "displayName", "questionId",
              "prompt", "answer", "isCorrect", "scoreDelta", "totalScore",
              "attemptCount", "createdAt", "createdAtMs"
            ]);
          allow update, delete: if false;
        }

        match /operations/{uid}/items/{operationId} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create: if isRoomStudent(roomId)
            && activeRound(roomId, roundId)
            && request.auth.uid == uid
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.operationId == operationId
            && request.resource.data.playerId == uid
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.kind in ["attempt", "progress"]
            && (
              (request.resource.data.kind == "attempt" && request.resource.data.itemId is string)
              || (request.resource.data.kind == "progress" && request.resource.data.itemId == null)
            )
            && request.resource.data.revision is int
            && request.resource.data.revision > 0
            && request.resource.data.createdAtMs is int
            && request.resource.data.keys().hasOnly([
              "operationId", "kind", "gameId", "playerId", "itemId", "revision", "createdAt", "createdAtMs"
            ]);
          allow update: if false;
          allow delete: if isRoomAdmin(roomId);
        }

        match /progress/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create: if isRoomStudent(roomId)
            && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId != "free-response"
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.revision == 1
            && request.resource.data.lastOperationId is string
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(uid)/items/$(request.resource.data.lastOperationId)).data.revision == request.resource.data.revision
            && request.resource.data.keys().hasOnly([
              "gameId", "playerId", "displayName", "currentIndex", "score",
              "correctCount", "attemptCount", "combo", "completedQuestionIds", "lastResult",
              "completedAtMs", "revision", "lastOperationId", "updatedAt", "updatedAtMs"
            ])
            && request.resource.data.combo is int
            && request.resource.data.combo >= 0;
          allow update: if isRoomStudent(roomId)
            && resource.data.gameId != "free-response"
            && get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId != "free-response"
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.revision is int
            && (
              (!("revision" in resource.data) && request.resource.data.revision == 1)
              || (resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1)
            )
            && request.resource.data.lastOperationId is string
            && getAfter(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/operations/$(uid)/items/$(request.resource.data.lastOperationId)).data.revision == request.resource.data.revision
            && request.resource.data.keys().hasOnly([
              "gameId", "playerId", "displayName", "currentIndex", "score",
              "correctCount", "attemptCount", "combo", "completedQuestionIds", "lastResult",
              "completedAtMs", "revision", "lastOperationId", "updatedAt", "updatedAtMs"
            ])
            && request.resource.data.combo is int
            && request.resource.data.combo >= 0;
          allow delete: if isRoomAdmin(roomId);
        }

        match /liveMetrics/{uid} {
          allow read: if isRoomAdmin(roomId) || (isRoomStudent(roomId) && request.auth.uid == uid);
          allow create, update: if isRoomStudent(roomId)
            && request.auth.uid == uid
            && activeRound(roomId, roundId)
            && exists(/databases/$(database)/documents/multiplayerSessions/$(roomId)/rounds/$(roundId)/participants/$(uid))
            && request.resource.data.playerId == uid
            && request.resource.data.displayName == request.auth.token.displayName
            && request.resource.data.gameId == get(/databases/$(database)/documents/multiplayerSessions/$(roomId)).data.gameId
            && request.resource.data.kind == "typing-cpm"
            && request.resource.data.currentCpm is int
            && request.resource.data.currentCpm >= 0
            && request.resource.data.currentCpm <= 5000
            && request.resource.data.averageCpm is int
            && request.resource.data.averageCpm >= 0
            && request.resource.data.averageCpm <= 5000
            && request.resource.data.bestCpm is int
            && request.resource.data.bestCpm >= 0
            && request.resource.data.bestCpm <= 5000
            && request.resource.data.bestCpm >= request.resource.data.currentCpm
            && request.resource.data.bestCpm >= request.resource.data.averageCpm
            && request.resource.data.totalValidStrokes is int
            && request.resource.data.totalValidStrokes >= 0
            && request.resource.data.totalValidStrokes <= 1000000
            && (!("currentStage" in request.resource.data) || (
              request.resource.data.currentStage is int
              && request.resource.data.currentStage >= 1
              && request.resource.data.currentStage <= 10
            ))
            && request.resource.data.sampledAtMs is int
            && request.resource.data.committedAt == request.time
            && request.resource.data.keys().hasOnly([
              "kind", "gameId", "playerId", "displayName", "currentCpm", "averageCpm",
              "bestCpm", "totalValidStrokes", "currentStage", "sampledAtMs", "committedAt"
            ]);
          allow delete: if isRoomAdmin(roomId);
        }
      }
    }
  }
}
